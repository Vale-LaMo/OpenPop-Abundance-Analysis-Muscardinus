mapping <- arrange(distinct(dormouse.proc$data[,c("group", "area")]), group)
area_names <- mapping$area
n_areas <- length(area_names)
n_occasions <- K_total
# 3. Creazione dataframe base
abund_clean <- data.frame(
Area = rep(area_names, each = n_occasions),
Occasion = rep(1:n_occasions, times = n_areas),
Date = rep(master_dates, times = n_areas),
Estimate = abund_data$estimate,
SE = abund_data$se,
LCL = abund_data$lcl,
UCL = abund_data$ucl
)
# 4. Gestione della nota "f0 vs N" (Solo se is_averaged = TRUE)
# Se il model average ha restituito f0, dobbiamo sommare Mt specifico per gruppo
if (is_averaged && !is.null(Mt_data)) {
# Assicuriamoci che Mt_data sia ordinato come area_names
Mt_ordered <- Mt_data[match(area_names, Mt_data$area), "Mt"]
abund_clean$Estimate <- abund_clean$Estimate + rep(Mt_ordered, each = n_occasions)
abund_clean$LCL      <- abund_clean$LCL + rep(Mt_ordered, each = n_occasions)
abund_clean$UCL      <- abund_clean$UCL + rep(Mt_ordered, each = n_occasions)
}
# 6. Plotting
p <- ggplot(abund_clean, aes(x = Date, y = Estimate, group = Area, color = Area, fill = Area)) +
geom_ribbon(aes(ymin = LCL, ymax = UCL), color = NA, alpha = 0.2) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
facet_wrap(~ Area, ncol = 3, scales = "free_y") +
scale_color_brewer(palette = "Dark2") +
scale_fill_brewer(palette = "Dark2") +
labs(
title = "Seasonal Population Abundance (N-hat)",
subtitle = "POPAN Model: Estimates for each sampling occasion",
x = "Survey Date",
y = "Estimated N"
) +
theme_minimal() +
theme(
legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1)
)
return(list(plot = p, data = abund_clean))
}
# Calcola il numero totale di individui unici catturati per ogni area
Mt_table <- aggregate(rep(1, nrow(all_data_ch)), by=list(area=all_data_ch$area), sum)
names(Mt_table) <- c("area", "Mt")
N_avg <- model.average(dormouse.results, "derived", parameter="N")
res_avg <- get_popan_N_trends(N_avg, is_averaged = TRUE, Mt_data = Mt_table)
get_popan_N_trends <- function(chosen_model, is_averaged = FALSE, Mt_data = NULL) {
# 1. Estrazione stime con gestione errori nomi colonne
if (is_averaged) {
# model.average restituisce una lista dove i dati sono spesso in $estimates
# ma a volte i nomi delle colonne cambiano (es. 'Estimate' invece di 'estimate')
raw_estimates <- chosen_model$estimates
} else {
raw_estimates <- chosen_model$results$derived$N
}
# Verifichiamo se raw_estimates è vuoto
if (is.null(raw_estimates) || nrow(raw_estimates) == 0) {
stop("Errore: Le stime del modello sono vuote. Controlla l'oggetto scelto.")
}
# Normalizziamo i nomi delle colonne per ggplot (MARK a volte usa maiuscole/minuscole diverse)
est_vec <- if(!is.null(raw_estimates$estimate)) raw_estimates$estimate else raw_estimates$Estimate
se_vec  <- if(!is.null(raw_estimates$se)) raw_estimates$se else raw_estimates$SE
lcl_vec <- if(!is.null(raw_estimates$lcl)) raw_estimates$lcl else raw_estimates$LCL
ucl_vec <- if(!is.null(raw_estimates$ucl)) raw_estimates$ucl else raw_estimates$UCL
# 2. Mapping robusto Aree-Gruppi
# Fondamentale per evitare lo scambio S2 <-> R2/R3
mapping <- arrange(distinct(dormouse.proc$data[,c("group", "area")]), group)
area_names <- mapping$area
n_areas <- length(area_names)
n_occasions <- K_total
# 3. Creazione dataframe base
abund_clean <- data.frame(
Area = rep(area_names, each = n_occasions),
Occasion = rep(1:n_occasions, times = n_areas),
Date = rep(master_dates, times = n_areas),
Estimate = abund_data$estimate,
SE = abund_data$se,
LCL = abund_data$lcl,
UCL = abund_data$ucl
)
# 4. Gestione della nota "f0 vs N" (Solo se is_averaged = TRUE)
# Se il model average ha restituito f0, dobbiamo sommare Mt specifico per gruppo
if (is_averaged && !is.null(Mt_data)) {
# Assicuriamoci che Mt_data sia ordinato come area_names
Mt_ordered <- Mt_data[match(area_names, Mt_data$area), "Mt"]
abund_clean$Estimate <- abund_clean$Estimate + rep(Mt_ordered, each = n_occasions)
abund_clean$LCL      <- abund_clean$LCL + rep(Mt_ordered, each = n_occasions)
abund_clean$UCL      <- abund_clean$UCL + rep(Mt_ordered, each = n_occasions)
}
# 6. Plotting
p <- ggplot(abund_clean, aes(x = Date, y = Estimate, group = Area, color = Area, fill = Area)) +
geom_ribbon(aes(ymin = LCL, ymax = UCL), color = NA, alpha = 0.2) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
facet_wrap(~ Area, ncol = 3, scales = "free_y") +
scale_color_brewer(palette = "Dark2") +
scale_fill_brewer(palette = "Dark2") +
labs(
title = "Seasonal Population Abundance (N-hat)",
subtitle = "POPAN Model: Estimates for each sampling occasion",
x = "Survey Date",
y = "Estimated N"
) +
theme_minimal() +
theme(
legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1)
)
return(list(plot = p, data = abund_clean))
}
get_popan_N_trends <- function(chosen_model, is_averaged = FALSE, Mt_data = NULL) {
# 1. Estrazione stime con gestione errori nomi colonne
if (is_averaged) {
# model.average restituisce una lista dove i dati sono spesso in $estimates
# ma a volte i nomi delle colonne cambiano (es. 'Estimate' invece di 'estimate')
raw_estimates <- chosen_model$estimates
} else {
raw_estimates <- chosen_model$results$derived$N
}
# Verifichiamo se raw_estimates è vuoto
if (is.null(raw_estimates) || nrow(raw_estimates) == 0) {
stop("Errore: Le stime del modello sono vuote. Controlla l'oggetto scelto.")
}
# Normalizziamo i nomi delle colonne per ggplot (MARK a volte usa maiuscole/minuscole diverse)
est_vec <- if(!is.null(raw_estimates$estimate)) raw_estimates$estimate else raw_estimates$Estimate
se_vec  <- if(!is.null(raw_estimates$se)) raw_estimates$se else raw_estimates$SE
lcl_vec <- if(!is.null(raw_estimates$lcl)) raw_estimates$lcl else raw_estimates$LCL
ucl_vec <- if(!is.null(raw_estimates$ucl)) raw_estimates$ucl else raw_estimates$UCL
# 2. Mapping robusto Aree-Gruppi
# Fondamentale per evitare lo scambio S2 <-> R2/R3
mapping <- arrange(distinct(dormouse.proc$data[,c("group", "area")]), group)
area_names <- mapping$area
n_areas <- length(area_names)
n_occasions <- K_total
# 3. Creazione dataframe base
abund_clean <- data.frame(
Area = rep(area_names, each = n_occasions),
Occasion = rep(1:n_occasions, times = n_areas),
Date = rep(master_dates, times = n_areas),
Estimate = abund_data$estimate,
SE = abund_data$se,
LCL = abund_data$lcl,
UCL = abund_data$ucl
)
# 4. Gestione della nota "f0 vs N" (Solo se is_averaged = TRUE)
# Se il model average ha restituito f0, dobbiamo sommare Mt specifico per gruppo
if (is_averaged && !is.null(Mt_data)) {
# Assicuriamoci che Mt_data sia ordinato come area_names
Mt_ordered <- Mt_data[match(area_names, Mt_data$area), "Mt"]
abund_clean$Estimate <- abund_clean$Estimate + rep(Mt_ordered, each = n_occasions)
abund_clean$LCL      <- abund_clean$LCL + rep(Mt_ordered, each = n_occasions)
abund_clean$UCL      <- abund_clean$UCL + rep(Mt_ordered, each = n_occasions)
}
# 6. Plotting
p <- ggplot(abund_clean, aes(x = Date, y = Estimate, group = Area, color = Area, fill = Area)) +
geom_ribbon(aes(ymin = LCL, ymax = UCL), color = NA, alpha = 0.2) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
facet_wrap(~ Area, ncol = 3, scales = "free_y") +
scale_color_brewer(palette = "Dark2") +
scale_fill_brewer(palette = "Dark2") +
labs(
title = "Seasonal Population Abundance (N-hat)",
subtitle = "POPAN Model: Estimates for each sampling occasion",
x = "Survey Date",
y = "Estimated N"
) +
theme_minimal() +
theme(
legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1)
)
return(list(plot = p, data = abund_clean))
}
# Calcola il numero totale di individui unici catturati per ogni area
Mt_table <- aggregate(rep(1, nrow(all_data_ch)), by=list(area=all_data_ch$area), sum)
names(Mt_table) <- c("area", "Mt")
N_avg <- model.average(dormouse.results, "derived", parameter="N")
res_avg <- get_popan_N_trends(N_avg, is_averaged = TRUE, Mt_data = Mt_table)
N.estimates
dormouse.results
# extract 'estimate' from the three models
N4 <- model4$results$derived$N$estimate
N4
# averaged trends
w4 <- dormouse.results$weight[1]
w5 <- dormouse.results$weight[2]
w3 <- dormouse.results$weight[3]
# sum weight to normalise them (sum to 1)
sum_weights <- w4 + w5 + w3
W4 <- w4 / sum_weights
W5 <- w5 / sum_weights
W3 <- w3 / sum_weights
# extract 'estimate' from the three models
N4 <- model4$results$derived$N$estimate
N5 <- model5$results$derived$N$estimate
N3 <- model3$results$derived$N$estimate
N_averaged_estimates <- (N4 * W4) + (N5 * W5) + (N3 * W3)
abund_final <- data.frame(
Area = rep(area_names, each = n_occasions),
Occasion = rep(1:23, times = 6),
Date = rep(master_dates, times = 6),
Estimate = N_averaged_estimates
)
rep(area_names, each = n_occasions)
rep(1:23, times = 6)
rep(master_dates, times = 6)
N_averaged_estimates
(N4 * W4) + (N5 * W5) + (N3 * W3)
N4 * W4
N4
W4
w4 + w5 + w3
dormouse.results$weight[1]
dormouse.results
dormouse.results$model.table$weight[1]
# averaged trends
w4 <- dormouse.results$model.table$weight[1]
w5 <- dormouse.results$model.table$weight[2]
w3 <- dormouse.results$model.table$weight[3]
# sum weight to normalise them (sum to 1)
sum_weights <- w4 + w5 + w3
W4 <- w4 / sum_weights
W5 <- w5 / sum_weights
W3 <- w3 / sum_weights
# extract 'estimate' from the three models
N4 <- model4$results$derived$N$estimate
N5 <- model5$results$derived$N$estimate
N3 <- model3$results$derived$N$estimate
N_averaged_estimates <- (N4 * W4) + (N5 * W5) + (N3 * W3)
N_averaged_estimates
abund_final <- data.frame(
Area = rep(area_names, each = n_occasions),
Occasion = rep(1:23, times = 6),
Date = rep(master_dates, times = 6),
Estimate = N_averaged_estimates
)
# SE_avg = sqrt( sum( W_i * (SE_i^2 + (N_i - N_avg)^2) ) )
SE4 <- model4$results$derived$N$se
SE5 <- model5$results$derived$N$se
SE3 <- model3$results$derived$N$se
abund_final$SE <- sqrt(
W4 * (SE4^2 + (N4 - N_averaged_estimates)^2) +
W5 * (SE5^2 + (N5 - N_averaged_estimates)^2) +
W3 * (SE3^2 + (N3 - N_averaged_estimates)^2)
)
# approximate confidence intervale
abund_final$LCL <- abund_final$Estimate - (1.96 * abund_final$SE)
abund_final$UCL <- abund_final$Estimate + (1.96 * abund_final$SE)
abund_final
